#!/usr/bin/env bash
# ~/.config/sketchybar/sketchybarrc
# Minimal SketchyBar config: shows AeroSpace workspaces on the macOS top bar.
# Only workspaces that contain windows (or the focused one) are shown.
# Managed in anonimitoraf/.dotfiles -> symlinked to ~/.config/sketchybar/.

PLUGIN_DIR="$CONFIG_DIR/plugins"

# --- Bar appearance ---------------------------------------------------------
sketchybar --bar \
    height=32 \
    position=top \
    padding_left=8 \
    padding_right=8 \
    color=0xff1f1f1f          # matches i3 client.focused background (#1f1f1f)

# --- Global defaults --------------------------------------------------------
sketchybar --default \
    icon.font="SF Pro:Semibold:14.0" \
    icon.color=0xffc6c6c6 \
    label.font="SF Pro:Semibold:14.0" \
    label.color=0xffc6c6c6 \
    background.corner_radius=6 \
    background.height=24 \
    padding_left=4 \
    padding_right=4

# --- Custom event -----------------------------------------------------------
# Must be declared before any item can subscribe to it. Triggered by aerospace's
# exec-on-workspace-change callback (see .aerospace.toml).
sketchybar --add event aerospace_workspace_change

# --- Workspaces (left side) -------------------------------------------------
# One item per AeroSpace workspace. Each subscribes to aerospace_workspace_change
# plus front_app_switched (so items appear/disappear as windows open/close).
# click_script uses $sid (baked in per-item), not $NAME (which is "space.<id>").
SPACE_CLICK_SCRIPT="aerospace workspace"

for sid in 1 2 3 4 5 6 7 8 9; do
    sketchybar --add item space.$sid left \
        --subscribe space.$sid aerospace_workspace_change front_app_switched \
        --set space.$sid \
            icon="$sid" \
            icon.padding_left=8 \
            icon.padding_right=8 \
            label.drawing=off \
            background.color=0xff2e2e2e \
            background.drawing=off \
            click_script="$SPACE_CLICK_SCRIPT $sid" \
            script="$PLUGIN_DIR/aerospace.sh $sid"
done

# --- Right side: clock ------------------------------------------------------
sketchybar --add item clock right \
    --set clock \
        update_freq=10 \
        icon= \
        icon.padding_right=6 \
        script="$PLUGIN_DIR/clock.sh" \
    --subscribe clock system_woke

# --- Finalize ---------------------------------------------------------------
sketchybar --update
